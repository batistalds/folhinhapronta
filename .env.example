# E-mails (Resend): confirmação para o cliente e aviso de venda
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="Folhinha Pronta <contato@folhinhapronta.com.br>"
CONTACT_EMAIL=seu-email-interno@exemplo.com
