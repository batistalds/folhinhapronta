# Frontend (Vite) — expostas ao navegador, usar apenas chaves públicas
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# Supabase Edge Functions (nunca no frontend / nunca commitadas)
# Configurar via: supabase secrets set NOME=valor
# ou no painel: Project Settings > Edge Functions > Secrets
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
SITE_URL=https://folhinhapronta.pages.dev

# E-mails (Brevo): confirmação para o cliente e aviso de venda
BREVO_API_KEY=xkeysib-xxxxxxxxxxxx
EMAIL_FROM_NAME="Folhinha Pronta"
EMAIL_FROM_ADDRESS=folhinhapronta@gmail.com
# Recebe o aviso de "Nova venda" — e-mail interno, nunca aparece para o cliente
CONTACT_EMAIL=seu-email-interno@exemplo.com
